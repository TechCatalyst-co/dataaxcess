{
  "name": "@dataaxcess/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:import-live-csv": "tsx src/db/import-live-csv.ts"
  },
  "dependencies": {
    "@dataaxcess/shared": "*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0"
  }
}
